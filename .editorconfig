root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 140

[*.{kt,kts}]
ij_kotlin_code_style = official
ij_kotlin_imports_layout = *
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,md}]
indent_size = 2
